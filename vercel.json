{
  "framework": "vite",
  "functions": { "api/admin.js": { "includeFiles": "dist/index.html" } },
  "rewrites": [
    { "source": "/admin", "destination": "/api/admin" },
    { "source": "/admin/:path*", "destination": "/api/admin" }
  ],
  "headers": [
    { "source": "/admin/:path*", "headers": [{ "key": "Cache-Control", "value": "private, no-store" }, { "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
